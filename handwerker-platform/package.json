{
  "name": "handwerker-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start --workdir supabase",
    "db:stop": "supabase stop --workdir supabase",
    "db:reset": "supabase db reset --workdir supabase",
    "db:gen-types": "supabase gen types typescript --local --workdir supabase > packages/shared-types/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}

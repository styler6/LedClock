{
  "expo": {
    "name": "Handwerker-Plattform",
    "slug": "handwerker-platform",
    "scheme": "handwerker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.handwerker.platform"
    },
    "android": {
      "package": "de.handwerker.platform"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
